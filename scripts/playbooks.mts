// Writes src/consult/playbooks.gen.ts from the playbooks in src/consult/playbooks/<layer>/<id>.md, so
// they load wherever Qalam runs (the window, the desktop core, dev, the tests and tsx, which can't import
// Markdown). Run after changing one:
//   pnpm gen:playbooks
// src/consult/playbooks.test.ts fails while the generated file and the Markdown differ.
import { readdirSync, readFileSync, statSync, writeFileSync } from "node:fs";
import { join, relative } from "node:path";
import { fileURLToPath } from "node:url";
import { playbooksFrom } from "../src/consult/playbook-md";

const root = fileURLToPath(new URL("..", import.meta.url));
const dir = join(root, "src/consult/playbooks");

/** Every playbook's file: Markdown in a layer's folder (CREDITS.md and the like at the top are for people). */
export function playbookFiles(from = dir): { path: string; text: string }[] {
  return readdirSync(from)
    .filter((d) => statSync(join(from, d)).isDirectory())
    .flatMap((d) =>
      readdirSync(join(from, d))
        .filter((f) => f.endsWith(".md"))
        .map((f) => ({ path: relative(root, join(from, d, f)), text: readFileSync(join(from, d, f), "utf8") })),
    )
    .sort((a, b) => a.path.localeCompare(b.path));
}

export function generated(): string {
  const books = playbooksFrom(playbookFiles());
  return [
    "// Generated by scripts/playbooks.mts from src/consult/playbooks/<layer>/<id>.md. Don't edit: change the",
    "// Markdown and run `pnpm gen:playbooks`.",
    'import type { Playbook } from "./playbook-md";',
    "",
    `export const PLAYBOOK_IDS = ${JSON.stringify(books.map((b) => b.id))} as const;`,
    "",
    "export type PlaybookId = (typeof PLAYBOOK_IDS)[number];",
    "",
    `export const PLAYBOOKS: readonly (Playbook & { id: PlaybookId })[] = ${JSON.stringify(books, null, 2)};`,
    "",
  ].join("\n");
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) {
  const out = join(root, "src/consult/playbooks.gen.ts");
  writeFileSync(out, generated());
  console.log(`Wrote ${relative(root, out)}`);
}
