# Server-side only. Never expose to the client.
ANTHROPIC_API_KEY=
# Optional: override the model for every step (default: claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Screen generation always uses Opus 5.5 unless overridden
# GENERATE_MODEL=claude-opus-5-5
# "Tune system" uses the generation model unless overridden
# TUNE_MODEL=claude-opus-5-5
# Plan first (the questions before Generate) uses the generation model unless overridden
# PLAN_MODEL=claude-opus-5-5
# Design-system extraction from screenshots (and its fidelity rebuild) uses Opus 5.5 unless overridden
# DS_EXTRACT_MODEL=claude-opus-5-5
# The quick first look at the screenshots before extracting (default: DS_EXTRACT_MODEL)
# DS_SCAN_MODEL=
# The self-check's repair pass after Generate (default: CLAUDE_MODEL)
# REPAIR_MODEL=
# These use the generation model unless overridden: prototypes, Discovery (boards, topic pages,
# Ask, setting an organization up) and the design-system brand interview
# PROTOTYPE_MODEL=
# DISCOVERY_MODEL=
# INTERVIEW_MODEL=
# Add component (a screenshot of one component) uses DS_EXTRACT_MODEL unless overridden
# COMPONENT_MODEL=
# Restyle and translation use CLAUDE_MODEL unless overridden
# RESTYLE_MODEL=
# TRANSLATE_MODEL=
# Route AI calls through the signed-in `claude` CLI (your Claude subscription) instead of an
# API key. Run `claude auth login` once. The desktop app does this on its own when no key is set.
# AI_BACKEND=cli
# CLAUDE_CLI_PATH=claude
# Connectors: what Qalam AI may look up before answering (the globe menu in the AI composer).
# Built-in web search is on unless WEB_SEARCH=off. With an API key, allow web search for your
# organization in the Claude Console.
# WEB_SEARCH=off
# Tavily search, through Tavily's hosted MCP server.
# TAVILY_API_KEY=
# Remote MCP servers, as JSON: [{"name":"docs","url":"https://example.com/mcp","token":"optional bearer token"}]
# MCP_SERVERS=
# AI_BACKEND=cli only: reuse MCP servers you connected in Claude Code, by name (logins included).
# CLI_MCP_SERVERS=mobbin,tavily-mcp
# Model for the research step (default: CLAUDE_MODEL)
# RESEARCH_MODEL=
# AI requests allowed per 10 minutes (default: 20)
# RATE_LIMIT_PER_10_MIN=20
# Where organizations live (default: ~/Qalam)
# QALAM_HOME=
