{
  "name": "qalam-studio",
  "productName": "Qalam Studio",
  "version": "0.1.0",
  "description": "An open-source, Arabic-first AI studio for product makers: discovery boards, a knowledge hub and design tools, on your own Claude Code.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "out/main.js",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "qalam-studio": "bin/qalam-studio.mjs"
  },
  "files": [
    "bin/",
    "out/",
    "dist/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build -c vite.desktop.config.ts && node scripts/build-voice.mjs && node scripts/build-see.mjs",
    "build:voice": "node scripts/build-voice.mjs",
    "build:see": "node scripts/build-see.mjs",
    "start": "NODE_ENV=production tsx server/serve.ts",
    "desktop": "pnpm build && pnpm build:desktop && electron .",
    "desktop:dev": "pnpm build:desktop && node scripts/desktop-dev.mjs",
    "dist:mac": "pnpm build && pnpm build:desktop && node scripts/stage-app.mjs && electron-builder --mac --projectDir release/app --config ../../electron-builder.yml",
    "prepack": "pnpm build && pnpm build:desktop",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:retrieval": "tsx eval/retrieval/run.ts",
    "eval:tiers": "tsx eval/tiers/run.ts"
  },
  "dependencies": {
    "electron": "^45.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@assistant-ui/react": "0.15.28",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@hugeicons/core-free-icons": "4.3.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/d3-force": "3.0.10",
    "@types/d3-quadtree": "3.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "canvaskit-wasm": "0.42.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "d3-force": "3.0.0",
    "d3-quadtree": "3.0.1",
    "electron-builder": "26.17.0",
    "electron-updater": "6.8.10",
    "hono": "^4.13.14",
    "immer": "^11.1.18",
    "lucide": "^1.48.0",
    "lucide-react": "^1.48.0",
    "mammoth": "1.13.0",
    "motion": "13.4.6",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "6.3.289",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.3.0",
    "react-grab": "0.2.0",
    "sucrase": "3.35.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.2",
    "yoga-layout": "^3.2.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "node-llama-cpp": "3.22.2"
  },
  "pnpm": {
    "overrides": {
      "@assistant-ui/core": "0.3.27",
      "@assistant-ui/store": "0.3.19",
      "@assistant-ui/tap": "0.9.23",
      "assistant-stream": "0.3.50",
      "assistant-cloud": "0.2.7",
      "safe-content-frame": "0.0.34",
      "radix-ui": "1.8.1"
    }
  }
}
